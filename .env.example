# Telegram bot token from @BotFather
BOT_TOKEN=

# Gemini API key from Google AI Studio (starts with AQ.)
GEMINI_API_KEY=

# Owner (you). Receives manual-payment claims and is the only one who can
# run /grant and /revoke in the bot. Use the numeric Telegram id.
ADMIN_USER_ID=
# Your public username (without @) so people can contact you to pay.
OWNER_USERNAME=

# Webhook mode (production / serverless). Leave WEBHOOK_URL empty to use
# long polling for local development.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook/kurdish-translate
# Shared secret that Telegram sends with every update. Set it and grammY
# will reject anything that doesn't have it. Generate with:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# Storage. Set REDIS_URL to a shared store (Upstash is fine) so user state
# survives between serverless invocations. Empty = in-memory (local dev).
REDIS_URL=

# HTTP port for the webhook server. Serverless hosts usually inject PORT.
PORT=8080

# Free tier translations per user per day (UTC)
FREE_DAILY_LIMIT=20

# Premium price in Telegram Stars for 30 days of unlimited translations
PREMIUM_PRICE_STARS=300